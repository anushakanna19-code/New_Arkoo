# ============================================================
# Arkoo Prebuild — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ─── GEMINI AI API ──────────────────────────────────────────
# Required for AI transcription, MOM generation, and Q&A.
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ─── APPLICATION URL ────────────────────────────────────────
# The public URL where this application is hosted.
# Used for OAuth callbacks, email links, and CORS.
APP_URL="http://localhost:3000"

# ─── GMAIL SMTP CREDENTIALS ────────────────────────────────
# Used for sending task assignment and invitation emails.
# Generate an App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"

# ─── CLOUDINARY (Audio CDN Storage) ─────────────────────────
# Used for instant MP3 audio CDN hosting.
# Sign up at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── GOOGLE OAUTH (Google Drive Integration) ────────────────
# Required for persistent admin Google Drive access.
# Create OAuth credentials in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── CORS CONFIGURATION ────────────────────────────────────
# Comma-separated list of allowed origins.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ─── RUNTIME ────────────────────────────────────────────────
# Set to "production" in deployment environments.
NODE_ENV="development"
PORT=3000
